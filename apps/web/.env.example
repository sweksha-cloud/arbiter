# Where the Arbiter server runs. Copy to .env.local to change it.
NEXT_PUBLIC_SERVER_URL=http://localhost:4000

# Set to false in production until the server has an email provider, to hide
# "Forgot your password?" and email-confirmation prompts.
# NEXT_PUBLIC_EMAIL_ENABLED=false

# Where people send privacy and account requests; shown on /privacy and /terms.
# NEXT_PUBLIC_CONTACT_EMAIL=
