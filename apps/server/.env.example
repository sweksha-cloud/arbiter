# Copy to .env for local development. Never commit real secrets.
HOST=0.0.0.0
PORT=4000
WEB_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://arbiter:arbiter@localhost:5432/arbiter
LOG_LEVEL=info
# Optional. Live sessions in Redis, so they survive restarts (`pnpm db:up` starts one). Without it, they're in memory.
# REDIS_URL=redis://localhost:6379
# Optional. Without it the server uses invented sample places. Never commit a real key.
# GOOGLE_PLACES_API_KEY=
# Set to true behind a reverse proxy (Caddy in production) so rate limits see real visitor IPs.
TRUST_PROXY=false
# E2E tests only: write emails (like reset links) to this folder instead of the log.
# MAIL_OUTBOX_DIR=
# Optional. fatsecret Platform API credentials for chain nutrition (sample places get sample nutrition without them).
# FATSECRET_CLIENT_ID=
# FATSECRET_CLIENT_SECRET=
