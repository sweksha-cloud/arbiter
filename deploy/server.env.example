# Copy to deploy/server.env on the server and fill in. Never commit server.env.

# The Vercel address of the web app, exactly as the browser shows it (no trailing slash).
WEB_ORIGIN=https://your-app.vercel.app

# Neon connection string (Dashboard > Connect). Keep ?sslmode=require.
DATABASE_URL=postgres://user:password@ep-xxxx.us-west-2.aws.neon.tech/neondb?sslmode=require

# Optional. Without it, sessions use invented sample places.
# GOOGLE_PLACES_API_KEY=

LOG_LEVEL=info
